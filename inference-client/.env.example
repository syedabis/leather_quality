# NOTE: do NOT create a .env file inside inference-client/.
# All credentials live in the .env at the project root (next to docker-compose.yml).
# inference-client/app/db/connection.py loads that file automatically.
#
# The variables it needs (already defined in the root .env):
#
#   DB_SERVER=localhost,1433     # SQL Server host:port the inference client reaches
#   DB_NAME=LeatherCount
#   DB_USER=sa
#   DB_PASSWORD=YourStrongPassword!
#   BACKEND_URL=http://localhost:8001   # leave empty to disable frame streaming
